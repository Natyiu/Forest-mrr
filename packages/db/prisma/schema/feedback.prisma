model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String
  message   String
  status    String   @default("open")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}
